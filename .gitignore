*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Coverage & testing
.coverage
.coverage.*
htmlcov/
